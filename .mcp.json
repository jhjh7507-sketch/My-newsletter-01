{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "/opt/pw-browsers/chromium"
      ]
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.34.1"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-}"
      }
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-}"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--headless",
        "--isolated",
        "--executablePath",
        "/opt/pw-browsers/chromium",
        "--chromeArg=--no-sandbox"
      ]
    },
    "glif": {
      "command": "npx",
      "args": ["-y", "@glifxyz/glif-mcp-server@0.9.9"],
      "env": {
        "GLIF_API_TOKEN": "${GLIF_API_TOKEN:-}"
      }
    }
  }
}
